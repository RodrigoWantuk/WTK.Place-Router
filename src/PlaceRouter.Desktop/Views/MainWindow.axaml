<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:views="using:PlaceRouter.Presentation.Views"
        x:Class="PlaceRouter.Desktop.Views.MainWindow"
        x:CompileBindings="False"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="680"
        Background="#171B20"
        Title="{Binding Title}">
  <Grid RowDefinitions="42,38,*,26">
    <Border Background="#20262C" BorderBrush="#39424C" BorderThickness="0,0,0,1" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <TextBlock Text="WTK Place&amp;Router" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Opacity="0.68" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="New" Command="{Binding NewProjectCommand}" Padding="10,4" />
          <Button Content="Open" Click="OpenProject_Click" Padding="10,4" />
          <Button Content="Import DSN" Click="ImportDsn_Click" Padding="10,4" />
          <Button Content="Save" Click="SaveProject_Click" Padding="10,4" />
          <Button Content="Save As" Click="SaveProjectAs_Click" Padding="10,4" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#242A30" BorderBrush="#39424C" BorderThickness="0,0,0,1" Padding="10,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Reset Layout" Command="{Binding ResetLayoutCommand}" Padding="10,3" />
        <Button Content="Close Project" Command="{Binding CloseProjectCommand}" Padding="10,3" />
      </StackPanel>
    </Border>

    <dock:DockControl Grid.Row="2"
                      Layout="{Binding DockLayout}"
                      Factory="{Binding DockFactory}"
                      DefaultContext="{Binding}"
                      InitializeFactory="True"
                      EnableManagedWindowLayer="True"
                      IsDockingEnabled="True" />

    <views:StatusBarView Grid.Row="3" DataContext="{Binding StatusBar}" />
  </Grid>
</Window>
